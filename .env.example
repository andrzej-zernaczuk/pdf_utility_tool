# LLM configuration for AI-powered filename suggestions (all fields optional)
#
# LLM_BASE_URL sets the API endpoint. Any OpenAI-compatible provider works:
#   Groq:   https://api.groq.com/openai/v1
#   OpenAI: https://api.openai.com/v1  (or omit — this is the default)
#   Ollama: http://localhost:11434/v1
#
# Leave LLM_API_KEY and LLM_MODEL_ID empty to disable LLM suggestions.

LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL_ID=gemma2-9b-it
